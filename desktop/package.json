{
  "name": "residence-desktop",
  "version": "1.0.0",
  "description": "Residence Mac menu-bar app — capture Claude/Notes → Accept/Decline → shared Facts",
  "main": "main.js",
  "author": "Residence",
  "license": "Apache-2.0",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "npm run start",
    "test": "node --test integrations/*.test.js && npm run test:pill",
    "test:pill": "env -u ELECTRON_RUN_AS_NODE electron tools/pill-smoke.js",
    "pack": "env -u ELECTRON_RUN_AS_NODE electron-builder --dir && npm run sign:adhoc",
    "dist": "env -u ELECTRON_RUN_AS_NODE electron-builder --mac zip && npm run sign:adhoc",
    "dist:dmg": "env -u ELECTRON_RUN_AS_NODE electron-builder --mac dmg && npm run sign:adhoc",
    "sign:adhoc": "bash -c 'APP=dist/mac-arm64/Residence.app; test -d \"$APP\" || APP=dist/mac/Residence.app; codesign --force --deep --sign - \"$APP\" && xattr -cr \"$APP\"'",
    "dist:release": "bash ../scripts/release-mac.sh"
  },
  "build": {
    "appId": "ai.residence.desktop",
    "productName": "Residence",
    "icon": "assets/Residence.icns",
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["zip", "dmg"],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Residence writes accepted Facts into Calendar, Notes, and Reminders.",
        "NSAppleScriptEnabled": true,
        "NSHumanReadableCopyright": "Residence — personal context graph",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Residence",
            "CFBundleURLSchemes": ["residence"]
          }
        ]
      }
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "status.html",
      "entitlements.mac.plist",
      "integrations/**/*",
      "!integrations/*.test.js",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "mcp",
        "to": "mcp"
      }
    ]
  },
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12"
  }
}
