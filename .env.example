# Residence production / local configuration
# Copy to .env and fill in values.

RESIDENCE_ENV=development
# production requires RESIDENCE_API_KEY unless RESIDENCE_REQUIRE_AUTH=0
RESIDENCE_API_KEY=
RESIDENCE_REQUIRE_AUTH=0
RESIDENCE_ALLOW_RESET=1
RESIDENCE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RESIDENCE_RATE_LIMIT_PER_MINUTE=120
RESIDENCE_PERSIST_DIR=
RESIDENCE_LOG_LEVEL=INFO
RESIDENCE_AGENT_CACHE_TTL=30

CORE_HOST=127.0.0.1
CORE_PORT=8700
CORE_PUBLIC_URL=http://127.0.0.1:8700

DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=
# DataHub React UI (quickstart default :9002). Used for Graph deep-links.
DATAHUB_UI_URL=http://localhost:9002
DATAHUB_TIER=oss

# Optional LLM refine / Claude bridge
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
